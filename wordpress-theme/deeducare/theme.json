{
	"$schema": "https://schemas.wp.org/wp/6.4/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "900px", "wideSize": "1280px" },
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "primary", "color": "#1F3A8A", "name": "Brand blue" },
				{ "slug": "primary-hover", "color": "#15296A", "name": "Brand blue (hover)" },
				{ "slug": "primary-soft", "color": "#E3E8F7", "name": "Brand blue (soft)" },
				{ "slug": "ink", "color": "#0E1230", "name": "Ink" },
				{ "slug": "muted", "color": "#5A5F78", "name": "Muted text" },
				{ "slug": "page", "color": "#F5F3EE", "name": "Page background" },
				{ "slug": "card", "color": "#FFFFFF", "name": "Card" },
				{ "slug": "line", "color": "#E2DED3", "name": "Line" },
				{ "slug": "chip", "color": "#EAE6DB", "name": "Chip" },
				{ "slug": "amber", "color": "#FFC44D", "name": "Amber" },
				{ "slug": "amber-soft", "color": "#FFE3A0", "name": "Amber (soft)" }
			]
		},
		"typography": {
			"fontFamilies": [
				{ "slug": "manrope", "name": "Manrope", "fontFamily": "Manrope, system-ui, sans-serif" },
				{ "slug": "plex-mono", "name": "IBM Plex Mono", "fontFamily": "'IBM Plex Mono', ui-monospace, monospace" }
			]
		},
		"spacing": { "units": [ "px", "%", "rem", "vw" ] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--page)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--manrope)" },
		"spacing": { "blockGap": "0px" },
		"elements": {
			"link": { "color": { "text": "var(--wp--preset--color--primary)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
