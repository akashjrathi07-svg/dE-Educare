# Copy to .env.local and fill in. Never commit the real file.

# Postgres connection string (Supabase: Project Settings → Database → Connection string, "Session pooler").
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deeducare

# Public URL of this app, and the cookie domain shared with the website (leading dot for subdomains).
APP_URL=http://localhost:3000
COOKIE_DOMAIN=
WEBSITE_URL=https://deeducare.com

# OTP SMS. "console" prints the code in the server log (development only). "msg91" sends real SMS.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Guru (AI mentor). Without a key Guru answers with fixed study tips.
ANTHROPIC_API_KEY=
GURU_MODEL=claude-opus-5-5

# Razorpay. Without keys, checkout uses a test-mode payment page (refused in production).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
